# Same physical Postgres DB as gc-ai-assistant (the dashboard app) — this
# service reads Account.refresh_token (written by the dashboard's NextAuth
# sign-in) and writes EmailRecord rows the dashboard reads back.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Same Google OAuth client as the dashboard app (needed to refresh access
# tokens using the stored refresh_token).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

ANTHROPIC_API_KEY=""

# Protects the cron-triggered bulk sync (Vercel Cron sends this as a Bearer token).
CRON_SECRET="run: openssl rand -base64 24"

# Protects the on-demand single-user sync path, called server-to-server from
# the dashboard app's /api/gmail/trigger-sync route. Must match the
# AGENT_SHARED_SECRET set in the dashboard app's env vars.
AGENT_SHARED_SECRET="run: openssl rand -base64 24"
